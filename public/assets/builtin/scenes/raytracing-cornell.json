      "scale": [0.55, 0.7, 0.55]
    },
    {
      "id": "tall-box",
      "name": "Tall Box",
      "model": "/assets/builtin/models/cube.glb",
      "material": "mat-white",
      "position": [0.5, 0.65, -0.35],
      "rotation": [0, -18, 0],
      "scale": [0.55, 1.3, 0.55]
    }
  ],
  "lights": [
    {
      "type": "area",
      "name": "Ceiling Area Light",
      "position": [0, 1.98, 0],
      "size": [0.65, 0.65, 1],
      "color": [1, 0.95, 0.86],
      "intensity": 12
    }
  ],
