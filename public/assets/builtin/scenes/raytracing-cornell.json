{
  "schema": "games-platform.scene-preset",
  "version": 1,
  "id": "raytracing-cornell",
  "name": "Ray Tracing Cornell Starter",
  "purpose": "A minimal Cornell-style scene description for future path tracing experiments.",
  "camera": {
    "position": [0, 1, 4],
    "target": [0, 1, 0],
    "fovYDegrees": 38,
    "near": 0.1,
    "far": 100
  },
  "environment": {
    "color": [0, 0, 0]
  },
  "materials": [
    {
      "id": "mat-white",
      "name": "White Diffuse",
      "baseColor": [0.78, 0.78, 0.74, 1],
      "roughness": 0.9
    },
    {
      "id": "mat-red",
      "name": "Red Wall",
      "baseColor": [0.78, 0.14, 0.12, 1],
      "roughness": 0.9
    },
    {
      "id": "mat-green",
      "name": "Green Wall",
      "baseColor": [0.12, 0.45, 0.18, 1],
      "roughness": 0.9
    }
  ],
  "meshes": [
    {
      "id": "floor",
      "name": "Cornell Floor",
      "model": "/assets/builtin/models/plane.glb",
